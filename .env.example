# Host port bound on 127.0.0.1 by compose.yaml
PORT=8080

# Upstream snapshot cache TTL
FEED_TTL=30s

# Optional: Magpie instance (both MAGPIE_URL and MAGPIE_WEB_KEY are required when enabled)
# MAGPIE_URL=http://magpie.example:8081
# MAGPIE_WEB_KEY=

# Optional: Gatus status API base URL
# GATUS_URL=http://host.docker.internal:3001

# Optional: Prometheus HTTP API base URL
# PROMETHEUS_URL=http://host.docker.internal:9090
# PROMETHEUS_JOB=node
# FLAKE_REPO=pelikanade/flake
# GITHUB_API_URL=https://api.github.com
